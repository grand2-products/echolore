{
  "name": "echolore",
  "version": "0.1.0",
  "private": true,
  "description": "EchoLore — AI-powered knowledge & meeting platform",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "biome check .",
    "lint:i18n": "node ./scripts/dev/check-web-i18n.mjs",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "dev:daily": "powershell -ExecutionPolicy Bypass -File ./dev.ps1",
    "docker:dev": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d",
    "docker:down": "docker compose -f docker-compose.yml -f docker-compose.dev.yml down",
    "docker:logs": "docker compose -f docker-compose.yml -f docker-compose.dev.yml logs -f",
    "db:migrate": "pnpm --filter api db:migrate",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.7",
    "dotenv-cli": "^11.0.0",
    "lefthook": "^2.1.4",
    "turbo": "^2.8.17",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "overrides": {
      "fast-xml-parser": ">=5.5.7",
      "picomatch": ">=4.0.4",
      "handlebars": ">=4.7.9",
      "brace-expansion": ">=2.0.3",
      "yaml": ">=2.8.3",
      "nodemailer": ">=8.0.4",
      "@tootallnate/once": ">=3.0.1",
      "axios": ">=1.15.2 <2",
      "protobufjs": ">=7.5.6 <8",
      "next": ">=16.2.6 <16.3",
      "fast-uri": ">=3.1.2 <4",
      "kysely": ">=0.28.17 <0.29",
      "langsmith": ">=0.6.0 <0.8",
      "fast-xml-builder": ">=1.1.7 <2"
    }
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  }
}
