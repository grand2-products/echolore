{
  "name": "echolore",
  "version": "0.1.0",
  "private": true,
  "description": "EchoLore — AI-powered knowledge & meeting platform",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "biome check .",
    "lint:i18n": "node ./scripts/dev/check-web-i18n.mjs",
    "check:i18n": "node ./scripts/dev/check-i18n-key-parity.mjs",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "dev:daily": "powershell -ExecutionPolicy Bypass -File ./dev.ps1",
    "docker:dev": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d",
    "docker:down": "docker compose -f docker-compose.yml -f docker-compose.dev.yml down",
    "docker:logs": "docker compose -f docker-compose.yml -f docker-compose.dev.yml logs -f",
    "db:migrate": "pnpm --filter api db:migrate",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.7",
    "dotenv-cli": "^11.0.0",
    "js-yaml": "^4.3.2",
    "lefthook": "^2.1.4",
    "turbo": "^2.9.14",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "overrides": {
      "fast-xml-parser": ">=5.7.0",
      "picomatch": ">=4.0.4",
      "handlebars": ">=4.7.10 <5",
      "brace-expansion": ">=5.0.11",
      "yaml": ">=2.8.3",
      "nodemailer": ">=10.0.6",
      "@tootallnate/once": ">=3.0.1",
      "axios": ">=1.20.0 <2",
      "protobufjs": ">=7.6.5 <8",
      "uuid": ">=11.1.1 <12",
      "qs": ">=6.16.1",
      "next": ">=16.4.3 <16.5",
      "fast-uri": ">=3.1.7 <4",
      "kysely": ">=0.28.17 <0.29",
      "langsmith": ">=0.6.0 <0.8",
      "fast-xml-builder": ">=1.1.7 <2",
      "hono": ">=4.13.11",
      "@grpc/grpc-js": ">=1.14.5",
      "ws": ">=8.21.0",
      "form-data": ">=4.0.6",
      "vite": ">=8.1.6",
      "browserslist": ">=4.28.7 <5",
      "fast-copy": ">=4.1.0 <5",
      "fflate": ">=0.8.3",
      "three-stdlib>fflate": ">=0.6.11 <0.7",
      "postcss-selector-parser": ">=6.1.5 <7",
      "prosemirror-view": ">=1.42.3 <2",
      "prosemirror-model": ">=1.25.12 <2",
      "prosemirror-transform": ">=1.12.4 <2",
      "prosemirror-history": ">=1.5.1 <2"
    }
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  }
}
